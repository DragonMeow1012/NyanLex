{
  "schemaVersion": 1,
  "id": "mctranslator",
  "version": "${version}",
  "name": "Minecraft Translator",
  "description": "Client-side translation into multiple target languages with OpenAI-compatible AI or Google, Youdao, DeepL, and Microsoft machine translation.",
  "authors": [
    "DragonMeow"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.dragonmeow.mctranslator.fabric.MctranslatorFabric"
    ]
  },
  "mixins": [
    {
      "config": "mctranslator.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "1.17.1",
    "java": ">=16",
    "fabric-api": "*"
  }
}
