{
  "schemaVersion": 1,
  "id": "mctranslator",
  "version": "${version}",
  "name": "Minecraft Translator",
  "description": "Translates chat, item tooltips, books, name tags, GUI/quest text and more into Traditional/Simplified Chinese (Google or AI).",
  "authors": [
    "DragonMeow"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.dragonmeow.mctranslator.fabric.MctranslatorFabric"
    ]
  },
  "mixins": [
    {
      "config": "mctranslator.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
